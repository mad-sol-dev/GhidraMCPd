{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search_functions.v1.json",
  "type": "object",
  "required": [
    "query",
    "page",
    "limit",
    "items",
    "has_more",
    "truncated"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of matches. Absent when the search paged by cursor and the total is not known -- it is never estimated."
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "address"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]+$"
          },
          "context": {
            "type": "object",
            "required": [
              "window",
              "disassembly"
            ],
            "properties": {
              "window": {
                "type": "object",
                "required": [
                  "before",
                  "after",
                  "center"
                ],
                "properties": {
                  "before": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "after": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "center": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]+$"
                  }
                },
                "additionalProperties": false
              },
              "disassembly": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "address",
                    "bytes",
                    "text"
                  ],
                  "properties": {
                    "address": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]+$"
                    },
                    "bytes": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "resume_cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "method_note": {
      "type": "string",
      "description": "Present only when the search returned nothing. Names what this search mode structurally cannot see and the path that does work. An empty result is a statement about the search, not about the binary."
    },
    "truncated": {
      "type": "boolean",
      "description": "True when results were left out. Separate from has_more/cursor, which say how to fetch the rest: a hard per-request cap truncates with nothing to page to."
    }
  },
  "additionalProperties": false
}
