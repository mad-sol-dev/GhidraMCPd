{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:search-scalars-with-context.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "matches",
    "has_more",
    "truncated",
    "returned"
  ],
  "properties": {
    "value": {
      "type": "string",
      "pattern": "^0x[0-9A-Fa-f]+$"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of matches. Absent when the search paged by cursor and the total is not known -- it is never estimated."
    },
    "has_more": {
      "type": "boolean"
    },
    "resume_cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "value"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]+$"
          },
          "value": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]+$"
          },
          "function": {
            "type": [
              "string",
              "null"
            ]
          },
          "context_text": {
            "type": "string"
          },
          "disassembly": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address",
                "bytes",
                "text"
              ],
              "properties": {
                "address": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]+$"
                },
                "bytes": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Rendered context lines. Present when fmt is \"text\"; disassembly is then absent."
          }
        },
        "anyOf": [
          {
            "required": [
              "disassembly"
            ]
          },
          {
            "required": [
              "lines"
            ]
          }
        ]
      }
    },
    "method_note": {
      "type": "string",
      "description": "Present only when the search returned nothing. Names what this search mode structurally cannot see and the path that does work. An empty result is a statement about the search, not about the binary."
    },
    "truncated": {
      "type": "boolean",
      "description": "True when results were left out. Separate from has_more/cursor, which say how to fetch the rest: a hard per-request cap truncates with nothing to page to."
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "description": "Entries on this page. Always present; unlike total it never depends on whether the search matched anything."
    }
  }
}
