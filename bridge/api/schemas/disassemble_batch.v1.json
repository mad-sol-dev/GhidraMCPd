{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:disassemble-batch.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "addresses",
    "count",
    "results"
  ],
  "properties": {
    "addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "count": {
      "type": "integer"
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address",
                "bytes",
                "text"
              ],
              "properties": {
                "address": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]+$"
                },
                "bytes": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "description": "Instruction objects when fmt is \"json\", rendered lines when \"text\"."
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "regex",
        "case_sensitive",
        "context_lines"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "regex": {
          "type": "boolean"
        },
        "case_sensitive": {
          "type": "boolean"
        },
        "context_lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      },
      "description": "Present only when a query was given; echoes what was asked for."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanned",
        "matched",
        "returned"
      ],
      "properties": {
        "scanned": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Present only when a query was given. returned exceeds matched when context_lines is set; the gap between scanned and returned is what the filter removed."
    }
  }
}
