{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:disassemble-batch.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "addresses",
    "count",
    "results"
  ],
  "properties": {
    "addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "count": {
      "type": "integer"
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address",
                "bytes",
                "text"
              ],
              "properties": {
                "address": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]+$"
                },
                "bytes": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "description": "Instruction objects when fmt is \"json\", rendered lines when \"text\"."
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "regex",
        "case_sensitive",
        "context_lines"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "regex": {
          "type": "boolean"
        },
        "case_sensitive": {
          "type": "boolean"
        },
        "context_lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      },
      "description": "Present only when a query was given; echoes what was asked for."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanned",
        "matched",
        "returned"
      ],
      "properties": {
        "scanned": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Present only when a query was given. returned exceeds matched when context_lines is set; the gap between scanned and returned is what the filter removed."
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requested_address",
          "start_address",
          "skipped_bytes"
        ],
        "properties": {
          "requested_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]+$"
          },
          "start_address": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0x[0-9a-fA-F]+$",
            "description": "First instruction actually listed; null when none is defined at or after the requested address."
          },
          "skipped_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Undefined bytes between the requested address and the first listed instruction."
          },
          "gaps": {
            "type": "array",
            "description": "Holes inside the listing -- undefined bytes or interior data such as a constant pool. Present only when there are any.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "bytes"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]+$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]+$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "description": "Present only when the listing does not start at the requested address or has holes. Its absence means the listing covers every byte from the requested address on."
      },
      "description": "Keyed by requested address; carries only the addresses whose listing does not start where it was asked to or has holes."
    },
    "method_note": {
      "type": "string",
      "description": "Present with coverage: what the listing leaves out and how to see those bytes instead."
    }
  }
}
