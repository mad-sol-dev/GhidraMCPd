{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_info.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_name",
    "image_base",
    "language_id",
    "compiler_spec_id",
    "entry_points",
    "memory_blocks",
    "imports_count",
    "exports_count",
    "writes_enabled"
  ],
  "properties": {
    "program_name": {
      "type": "string"
    },
    "executable_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "executable_md5": {
      "type": [
        "string",
        "null"
      ]
    },
    "executable_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "executable_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_base": {
      "type": [
        "string",
        "null"
      ]
    },
    "language_id": {
      "type": "string"
    },
    "compiler_spec_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "original_sha256",
          "modified_sha256",
          "patched"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "original_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "modified_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "patched": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "memory_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "start",
          "end",
          "length",
          "rwx",
          "loaded",
          "initialized"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "string",
              "null"
            ]
          },
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "rwx": {
            "type": "string",
            "pattern": "^[r-][w-][x-]$"
          },
          "loaded": {
            "type": "boolean"
          },
          "initialized": {
            "type": "boolean"
          },
          "source_file_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "file_offset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "imports_count": {
      "type": "integer",
      "minimum": 0
    },
    "exports_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "layout_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Present only when image_base or entry points lie outside every memory block."
    },
    "writes_enabled": {
      "type": "boolean",
      "description": "Whether write tools may write (GHIDRA_MCP_ENABLE_WRITES)."
    },
    "writes_note": {
      "type": "string",
      "description": "Present only while writes are off: how to turn them on."
    }
  }
}
